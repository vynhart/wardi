rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stores — anyone can read; only the owner can write
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.ownerUid == request.auth.uid;

      // Products — anyone can read; only the store owner can write
      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
      }

      // Orders — anyone can create (buyers aren't authenticated);
      // anyone can get a single order by ID (buyers viewing their own orders);
      // only the store owner can list all orders or update them
      match /orders/{orderId} {
        allow create: if true;
        allow get: if true;
        allow list, update: if request.auth != null
                            && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
